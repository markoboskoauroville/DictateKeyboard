<!--
  Monochrome layer for themed launcher icons (Android 13+) and the small notification icon.

  A plain microphone in the standard Material shape, which the system tints itself, so only the
  alpha of the path matters. Notification icons must be a simple single-colour vector, which is why
  this stays a vector rather than reusing the Om mark drawn for the launcher foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:pivotX="12"
        android:pivotY="12">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,14c1.66,0 3,-1.34 3,-3V5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6c0,1.66 1.34,3 3,3z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M17,11c0,2.76 -2.24,5 -5,5s-5,-2.24 -5,-5H5c0,3.53 2.61,6.43 6,6.92V21h2v-3.08c3.39,-0.49 6,-3.39 6,-6.92h-2z" />
    </group>
</vector>

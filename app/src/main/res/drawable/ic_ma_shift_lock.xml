<!--
    The Mac caps lock glyph, locked: the filled arrow with a bar beneath it.

    The bar is the whole message. It is what separates "the next letter" from "every letter until I
    say otherwise", and it is the part the Material set could not give in the same family as the
    other two.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="24dp"
        android:height="24dp"
        android:viewportWidth="24"
        android:viewportHeight="24">

    <path android:fillColor="#000000"
          android:pathData="M12,2.6 L20.4,11 L15.7,11 L15.7,16.4 L8.3,16.4 L8.3,11 L3.6,11 Z"/>
    <path android:fillColor="#000000"
          android:pathData="M8.3,18.6 L15.7,18.6 L15.7,21.4 L8.3,21.4 Z"/>
</vector>
